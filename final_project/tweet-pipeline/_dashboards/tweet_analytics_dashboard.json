{
  "datasets": [
    {
      "name": "d5adac76",
      "displayName": "Total Tweets Count (b)",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets\r\n",
        "FROM workspace.default.tweets_bronze;"
      ]
    },
    {
      "name": "f0030534",
      "displayName": "Tweets with Mentions Counter (s)",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_with_mentions\r\n",
        "FROM workspace.default.tweets_silver\r\n",
        "WHERE mention IS NOT NULL;"
      ]
    },
    {
      "name": "98835b1d",
      "displayName": "Tweets without Mentions Counter (s)",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_without_mentions\r\n",
        "FROM workspace.default.tweets_silver\r\n",
        "WHERE mention IS NULL;"
      ]
    },
    {
      "name": "9550ef05",
      "displayName": "Top 10 Users by Tweet Count (b)",
      "queryLines": [
        "SELECT\n",
        "  user,\n",
        "  COUNT(*) AS tweet_count\n",
        "FROM\n",
        "  workspace.default.tweets_bronze\n",
        "GROUP BY\n",
        "  user\n",
        "ORDER BY\n",
        "  tweet_count DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "92b6f957",
      "displayName": "Top 10 Most Positively Mentioned (app layer)",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  positive\n",
        "FROM\n",
        "  workspace.default.gold_tweet_aggregations\n",
        "ORDER BY\n",
        "  positive DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "1e155246",
      "displayName": "Top 10 Most Negatively Mentioned (app layer)",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  negative\n",
        "FROM\n",
        "  workspace.default.gold_tweet_aggregations\n",
        "ORDER BY\n",
        "  negative DESC\n",
        "LIMIT 10;"
      ]
    }
  ],
